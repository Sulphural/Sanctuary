<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(TargetFramework)</TargetFramework>
    <UserSecretsId>a8566dff-3d15-47ef-b515-7d41d8e1abee</UserSecretsId>
    <BaseOutputPath>$(SolutionDir)bin</BaseOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <ContainerDevelopmentMode>Regular</ContainerDevelopmentMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
    <PackageReference Include="NLog" />
    <PackageReference Include="NLog.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sanctuary.Core\Sanctuary.Core.csproj" />
    <ProjectReference Include="..\Sanctuary.Database\Sanctuary.Database.csproj" />
    <ProjectReference Include="..\Sanctuary.Game\Sanctuary.Game.csproj" />
    <ProjectReference Include="..\Sanctuary.Packet\Sanctuary.Packet.csproj" />
    <ProjectReference Include="..\Sanctuary.Scripting\Sanctuary.Scripting.csproj" />
    <ProjectReference Include="..\Sanctuary.UdpLibrary\Sanctuary.UdpLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="gateway.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="NLog.Development.config">
      <DependentUpon>NLog.config</DependentUpon>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    $(SolutionDir) is only auto-defined by MSBuild when a .sln file is the build entry point
    (e.g. Visual Studio). The Docker build invokes "dotnet build Sanctuary.Gateway.csproj" directly,
    which leaves SolutionDir undefined and silently no-ops these copies. Use $(MSBuildThisFileDirectory)
    (always this project's own directory) instead, so it works the same way everywhere.
  -->
  <Target Name="CopyResources" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <ResourceFiles Include="$(MSBuildThisFileDirectory)..\Resources\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ResourceFiles)" DestinationFolder="$(OutputPath)Resources\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyScripts" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <ScriptFiles Include="$(MSBuildThisFileDirectory)..\Scripts\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ScriptFiles)" DestinationFolder="$(OutputPath)Scripts\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
